# TaskOps 运行配置（复制为 .env 后修改；不要提交真实密码）
# 访问密码；留空 = 不启用登录
APP_PASSWORD=change-me
# 会话签名密钥；留空则由密码派生（改密码会让所有会话失效）
APP_SECRET=
# 会话有效天数
APP_SESSION_DAYS=7

# push-server 地址与写接口令牌（服务间调用）
PUSH_SERVER_URL=https://push-server.example.com
PUSH_SERVER_TOKEN=

# 壁纸图片接口地址。默认 random-image（直接返回一张图片）；
# 也支持模板占位符 {seed} / {width} / {height}，如：
# WALLPAPER_API_URL=https://picsum.photos/seed/{seed}/1920/1080
WALLPAPER_API_URL=https://random-image.xct258.top/

# 端口：前端静态服务 / 后端 FastAPI
FRONTEND_PORT=8281
BACKEND_PORT=8481
