# TaskOps 运行配置（复制为 .env 后修改；不要提交真实密钥）
# 是否启用统一登录（SSO）。本服务不提供登录页，登录由 auth-server 统一处理。
AUTH_ENABLED=true

# --- 本服务的独立 SSO 配置（在 auth-server 管理界面创建服务后复制）---
SERVICE_ID=taskops
SERVICE_SECRET=
SERVICE_TOKEN_VERSION=1
SSO_LOGIN_URL=https://auth.o1-1.xct258.top/login
SSO_COOKIE_NAME=sso_taskops
SSO_COOKIE_DOMAIN=.o1-1.xct258.top
SSO_ALLOWED_REDIRECT_SUFFIX=.o1-1.xct258.top

# push-server 地址与写接口令牌（服务间调用）
PUSH_SERVER_URL=https://push-server.example.com
PUSH_SERVER_TOKEN=

# 壁纸图片接口地址。默认 random-image（直接返回一张图片）；
# 也支持模板占位符 {seed} / {width} / {height}，如：
# WALLPAPER_API_URL=https://picsum.photos/seed/{seed}/1920/1080
WALLPAPER_API_URL=https://random-image.xct258.top/

# 端口：前端静态服务 / 后端 FastAPI
FRONTEND_PORT=8281
BACKEND_PORT=8481
